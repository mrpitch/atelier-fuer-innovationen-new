{
	"name": "atelier-fuer-innovationen-new",
	"version": "0.4.0",
	"private": true,
	"scripts": {
		"dev": "next dev",
		"build": "pnpm content:images && next build && pnpm pages:check",
		"start": "next start",
		"serve:out": "node scripts/serve-out.mts",
		"lint": "eslint --max-warnings 0",
		"spellcheck": "cspell --no-progress \"src/content/**/*.mdx\"",
		"typecheck": "next typegen && tsc --noEmit",
		"format": "prettier --write .",
		"format:check": "prettier --check .",
		"test": "vitest run",
		"content:check": "node scripts/content-check.mts",
		"content:images": "node scripts/content-images.mts",
		"illustration:export": "node scripts/illustration-export.mts",
		"docs:check": "node scripts/docs-check.mts",
		"pages:check": "node scripts/pages-check.mts",
		"links:check": "lychee --offline --no-progress --root-dir \"$PWD/out\" 'out/**/*.html'",
		"docs:lint": "markdownlint-cli2",
		"docs:index": "npx tsx \"$HOME/.claude/skills/docs/scripts/generate-index.ts\" docs",
		"check": "pnpm format:check && pnpm lint && pnpm spellcheck && pnpm typecheck && pnpm test && pnpm content:check && pnpm docs:check && pnpm docs:lint",
		"prepare": "husky",
		"afk": "~/Dev/home/tools/sandcastle/bin/sandcastle-run",
		"sandcastle:build": "DOCKER_BUILDKIT=1 docker build --build-arg AGENT_UID=$(id -u) --build-arg AGENT_GID=$(id -g) --build-arg PLAYWRIGHT_VERSION=$(grep -m1 -oE '^  playwright-core@[^:(]+' pnpm-lock.yaml | cut -d@ -f2) -t sandcastle:atelier-fuer-innovationen-new -f .sandcastle/Dockerfile ."
	},
	"dependencies": {
		"@base-ui/react": "^1.9.0",
		"@mdx-js/loader": "^3.1.1",
		"@mdx-js/react": "^3.1.1",
		"@next/mdx": "^16.4.6",
		"class-variance-authority": "^0.7.1",
		"cn": "^0.5.2",
		"lucide-react": "^1.77.0",
		"next": "16.4.6",
		"next-themes": "^0.4.6",
		"react": "19.3.0",
		"react-dom": "19.3.0",
		"remark-frontmatter": "^5.0.0",
		"remark-mdx-frontmatter": "^6.0.0",
		"shadcn": "^4.23.0",
		"tw-animate-css": "^1.4.0",
		"yaml": "^2.9.1",
		"zod": "^4.6.7"
	},
	"devDependencies": {
		"@cspell/dict-de-de": "^4.1.3",
		"@mdx-js/mdx": "^3.1.1",
		"@playwright/mcp": "^0.0.86",
		"@tailwindcss/turbopack": "4.3.3",
		"@types/mdx": "^2.0.14",
		"@types/node": "^20",
		"@types/react": "^19",
		"@types/react-dom": "^19",
		"cspell": "^10.5.2",
		"eslint": "^10.15.0",
		"eslint-config-next": "16.4.6",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-better-tailwindcss": "^4.11.0",
		"eslint-plugin-mdx": "^3.10.1",
		"eslint-plugin-simple-import-sort": "^14.0.0",
		"husky": "^9.1.7",
		"lint-staged": "^17.6.1",
		"markdownlint-cli2": "^0.24.2",
		"prettier": "^3.10.1",
		"prettier-plugin-tailwindcss": "^0.8.1",
		"tailwindcss": "4.3.3",
		"typescript": "^5",
		"vitest": "^5.1.1"
	},
	"engines": {
		"node": ">=24"
	},
	"packageManager": "pnpm@12.4.1",
	"remarkConfig": {
		"plugins": [
			"remark-frontmatter"
		]
	}
}
