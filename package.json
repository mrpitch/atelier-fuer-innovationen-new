		"next": "16.4.6",
		"next-themes": "^0.4.6",
		"react": "19.3.0",
		"react-dom": "19.3.0",
		"shadcn": "^4.23.0",
		"tw-animate-css": "^1.4.0"
	},
	"devDependencies": {
		"@playwright/mcp": "^0.0.86",
		"@tailwindcss/turbopack": "4.3.3",
		"@types/node": "^20",
