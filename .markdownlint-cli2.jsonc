{
	// Diataxis docs plus the three root Markdown files this project authors directly.
	// PRODUCT.md and DESIGN.md are generated by other skills (/impeccable, /docs write
	// product) with their own frontmatter dialect and heading conventions; they opt out
	// the same way content MDX does (#37 lints that separately).
	"globs": ["docs/**/*.md", "README.md", "AGENTS.md", "CLAUDE.md"],
	"config": {
		"default": true,
		// Prose isn't reflowed to a column width (prettier's default proseWrap is "preserve").
		"MD013": false,
		// AGENTS.md and CLAUDE.md are agent instructions, not Diataxis docs — they don't
		// open with an H1, and a doc's frontmatter `title` already carries that role.
		"MD041": false,
		// Fenced code examples keep the project's own tab indentation (prettier's useTabs).
		"MD010": { "code_blocks": false },
		// Every doc's frontmatter has a `title` key (the contract below) alongside its own
		// body H1 — without this, markdownlint counts the frontmatter title as a heading
		// and flags the real H1 as a duplicate.
		"MD025": { "front_matter_title": "" },
	},
}
