{
	"version": "0.2",
	// Content is German only, for UI copy and content (PRODUCT.md): no English fallback.
	"language": "de",
	"import": ["@cspell/dict-de-de/cspell-ext.json"],
	"allowCompoundWords": true,
	"ignoreRegExpList": [
		// Frontmatter IDs and slugs are identifiers, not prose: `id: foo-bar`, `slug: foo-bar`,
		// `customId: foo-bar`. Anchored to the key itself, not any key ending in "id"/"slug", so
		// a real word like `valid` or `uuid` doesn't exempt its whole line.
		"/^\\s*(?:id|slug|[a-zA-Z]+Id)\\s*:\\s*.*$/gm",
		// JSX tags and their props aren't prose either: `<ViertelCard id="01" />`.
		"/<[^>]+>/g"
	],
	"words": [
		// docs/reference/glossary.md headwords.
		"Navigation",
		"Menu",
		"Seite",
		"Viertel",
		"Leitsatz",
		"Steckbrief",
		"Zentrum",
		"Rundgang",
		"Station",
		"Thema",
		"Leitthema",
		"Kapitel",
		"Abschnitt",
		"Aufsatz",
		"Draft",
		"draft",
		// A frontmatter key (issue #93), lowercase like every other one here;
		// not a glossary headword since "Jahr" names no domain type of its own.
		"jahr",
		// Proper nouns (PRODUCT.md).
		"Xenia",
		"Xeniapolis",
		"Volkmann",
		// A Themen-Ort's own name (issue #31), not a German dictionary word.
		"Futursysteme",
		// A Station's placeholder title (issue #116, Figma): the Kondratiev
		// waves of economic theory, spelled as the Figma design's own copy
		// has it, not the German-literature "Kondratjew".
		"Kondratieffs"
	]
}
