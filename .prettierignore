# Prettier also reads the root .gitignore, but not nested ones such as
# .sandcastle/.gitignore. Entries already in the root .gitignore are repeated
# here for editor integrations that read only this file.

# Lockfiles at any depth, so the CDK subproject's lockfile from #4 too
pnpm-lock.yaml

# Next.js build output and generated types, also in the root .gitignore
.next
out
next-env.d.ts

# Sandcastle run artefacts that Prettier can parse, a subset of .sandcastle/.gitignore
.sandcastle/worktrees
.sandcastle/logs
.sandcastle/container-cache
.sandcastle/claude.json
.sandcastle/repair-context.md

# implement-epic notes, kept on the host and never committed
.epic-notes

# Claude Code's personal settings, written by Claude Code and ignored through
# the global git ignore file, which Prettier does not read
.claude/settings.local.json

# Generated docs index
docs/index.md

# Synthesis output of the CDK subproject from #4
cdk/cdk.out
